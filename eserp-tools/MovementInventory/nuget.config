<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Azure-DevOps-Feed Meesenburg.ES entfernt (19.11.2026): Core, Infrastructure.KeyVault, Jobs.*, SAP.Soap sind Projektverweise im Repo
       (Quelle = veröffentlichtes Paket, geprüft mit tools/eserp-tools/PackageSourceCompare) – kein Azure-DevOps-Token mehr nötig. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Plattform-Pakete Meesenburg.SiSe.* (Repo Meesenburg-GmbH/platform-dotnet, 19.11.2026) -->
    <add key="meesenburg-gmbh" value="https://nuget.pkg.github.com/Meesenburg-GmbH/index.json" />
  </packageSources>

  <!-- Jede Quelle nur für ihre Pakete: So fragt ein Build ohne SiSe-Pakete GitHub gar nicht erst (kein Token nötig),
       und ein gleichnamiges Paket in einer fremden Quelle kann nichts unterschieben. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="meesenburg-gmbh">
      <package pattern="Meesenburg.SiSe.*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Zugangsdaten nur über Umgebungsvariablen, nie in dieser Datei:
       GITHUB_PACKAGES_TOKEN (classic, read:packages) – lokal aus dem Schlüsselbund (Dienst github-packages-meesenburg),
       im ACR-Build als Build-Argument (PPR.DevTools). -->
  <packageSourceCredentials>
    <meesenburg-gmbh>
      <add key="Username" value="Meesenburg-GmbH" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </meesenburg-gmbh>
  </packageSourceCredentials>
</configuration>
