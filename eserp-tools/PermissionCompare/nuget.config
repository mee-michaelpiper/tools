<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources><clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="meesenburg-gmbh" value="https://nuget.pkg.github.com/Meesenburg-GmbH/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="meesenburg-gmbh"><package pattern="Meesenburg.SiSe.*" /></packageSource>
  </packageSourceMapping>
  <packageSourceCredentials><meesenburg-gmbh>
    <add key="Username" value="Meesenburg-GmbH" /><add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
  </meesenburg-gmbh></packageSourceCredentials>
</configuration>
